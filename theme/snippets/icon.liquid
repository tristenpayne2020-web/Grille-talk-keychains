{%- comment -%}
  Inline Lucide-style icons (ISC-licensed shapes, redrawn as 24px strokes). Decorative: aria-hidden, never focusable.
  usage: {% render 'icon', name: 'search', class: 'icon--sm' %}
{%- endcomment -%}
<svg class="icon {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>
    {%- when 'bag' -%}<path d="M6 7h12l1 13H5L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/>
    {%- when 'menu' -%}<path d="M4 8h16M4 16h16"/>
