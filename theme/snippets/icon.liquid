    {%- when 'play' -%}<path d="M8 5.5v13l11-6.5-11-6.5Z"/>
    {%- when 'skip' -%}<path d="m6 5 8 7-8 7V5Z"/><path d="M18 5v14"/>
  {%- endcase -%}
</svg>
