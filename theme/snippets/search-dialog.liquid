{%- comment -%}
  Search overlay with predictive results. Works without JS as a plain GET form to /search.
{%- endcomment -%}
<div class="dialog dialog--top" id="search-dialog" data-dialog role="dialog" aria-modal="true" aria-labelledby="search-dialog-title" hidden>
  <div class="dialog__scrim" data-close></div>
  <div class="dialog__panel">
    <div class="dialog__head page-width">
      <h2 class="t-eyebrow" id="search-dialog-title">{{ 'search.title' | t }}</h2>
      <button type="button" class="icon-btn" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="dialog__body page-width">
      <predictive-search>
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
          <label class="visually-hidden" for="search-dialog-input">{{ 'search.label' | t }}</label>
          <input
            class="input"
            id="search-dialog-input"
            type="search"
            name="q"
            placeholder="{{ 'search.placeholder' | t }}"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="false"
            aria-controls="predictive-results"
            aria-autocomplete="list"
          >
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
          <button class="btn" type="submit">{% render 'icon', name: 'search', class: 'icon--sm' %}<span>{{ 'search.submit' | t }}</span></button>
        </form>
        <div class="predictive" id="predictive-results" aria-live="polite"></div>
        <template data-loading>{% render 'skeleton', type: 'rows', count: 3 %}<p class="visually-hidden">{{ 'search.loading' | t }}</p></template>
      </predictive-search>
    </div>
  </div>
</div>
