{%- comment -%} Chapter rail icons for the detail tour, drawn for this site (aria-hidden, decorative). {%- endcomment -%}
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'lights' -%}<path d="M3 9c2 0 3 4 5 4s2.5-4 4.5-4 2.5 4 4.5 4 2-4 4-4"/><path d="M4 16h16" opacity=".4"/>
    {%- when 'grille' -%}<rect x="4" y="5" width="7" height="14" rx="3"/><rect x="13" y="5" width="7" height="14" rx="3"/><path d="M4 9h7M4 13h7M13 9h7M13 13h7"/>
    {%- when 'intakes' -%}<path d="M3 17 7 8h5l-2 9z"/><path d="M21 17 17 8h-5l2 9z"/>
