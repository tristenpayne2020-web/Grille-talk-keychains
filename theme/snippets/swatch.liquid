{%- comment -%}
  One option value as a radio chip. Colour, metalness and roughness come from a theme setting line
  "Name: #hex: metal: rough" (lines). usage: {% render 'swatch', oi: 1, cname: 'Matte Red', checked: selected, lines: swatch_lines %}
{%- endcomment -%}
{%- liquid
  assign hex = ''
  assign metal = '0'
  assign rough = '0.6'
  for sl in lines
    assign sp = sl | split: ':'
    assign sname = sp[0] | strip
    if sname == cname
      assign hex = sp[1] | strip
      assign metal = sp[2] | strip | default: '0'
      assign rough = sp[3] | strip | default: '0.6'
    endif
  endfor
  assign metal_f = metal | times: 1.0
  assign vid = cname | handleize
-%}
<span class="swatch{% if metal_f > 0.3 %} swatch--metal{% endif %}{% if hex == blank %} swatch--plain{% endif %}">
  <input
    type="radio"
    name="option-{{ oi }}"
    id="opt-{{ oi }}-{{ vid }}"
    value="{{ cname | escape }}"
    data-hex="{{ hex }}"
    data-metal="{{ metal }}"
    data-rough="{{ rough }}"
    {% if cname == checked %}checked{% endif %}
  >
  <label for="opt-{{ oi }}-{{ vid }}"{% if hex != blank %} style="--swatch: {{ hex }}"{% endif %}>{% if hex != blank %}<span class="swatch__chip" aria-hidden="true"></span>{% endif %}{{ cname | escape }}</label>
</span>
