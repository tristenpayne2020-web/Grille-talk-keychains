<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    {{ 'michroma-latin-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {% render 'meta-tags' %}

    {%- capture srcset_loader -%}{{ 'loader-art-1000.webp' | asset_url }} 1000w, {{ 'loader-art-1200.webp' | asset_url }} 1200w, {{ 'loader-art-2000.webp' | asset_url }} 2000w{%- endcapture -%}
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      {%- if template.name == 'index' %}
      try {
        if (!sessionStorage.getItem('gt-intro')) {
          sessionStorage.setItem('gt-intro', '1');
          document.documentElement.classList.add('gt-loading');
          var pl = document.createElement('link');
          pl.rel = 'preload'; pl.as = 'image'; pl.fetchPriority = 'high';
          pl.imageSrcset = {{ srcset_loader | json }};
          pl.imageSizes = '(max-aspect-ratio: 1/1) 135vw, 100vw';
          document.head.append(pl);
        }
      } catch (e) {}
      {%- endif %}
    </script>
    <script type="importmap">
      {
        "imports": {
          "vendor-three": "{{ 'vendor-three.js' | asset_url }}",
          "vendor-gsap": "{{ 'vendor-gsap.js' | asset_url }}",
          "keychain3d": "{{ 'keychain3d.js' | asset_url }}",
          "when3d": "{{ 'when3d.js' | asset_url }}",
          "chapters": "{{ 'chapters.js' | asset_url }}"
        }
      }
    </script>
    <script>
      window.GT = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          search: {{ routes.search_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          cartError: {{ 'cart.error_generic' | t | json }},
          searchError: {{ 'search.error' | t | json }},
          searchLoading: {{ 'search.loading' | t | json }},
          added: {{ 'cart.added' | t | json }}
        },
        meshopt: true
      };
    </script>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'global.js' | asset_url }}" type="module"></script>
    <script src="{{ 'chapters.js' | asset_url }}" type="module"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#main">{{ 'general.skip_to_content' | t }}</a>
    {%- if template.name == 'index' -%}{% render 'loader' %}{%- endif -%}
    <div class="hud" aria-hidden="true">
      <span class="hud__corner hud__corner--tl"></span><span class="hud__corner hud__corner--tr"></span>
      <span class="hud__corner hud__corner--bl"></span><span class="hud__corner hud__corner--br"></span>
      <span class="hud__progress" data-hud-progress></span>
      <span class="hud__chapter t-mono" data-hud-chapter></span>
    </div>
    {% sections 'header-group' %}

    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-dialog' %}
    {% section 'cart-drawer' %}
    <div class="visually-hidden" aria-live="polite" aria-atomic="true" id="live-region"></div>
  </body>
</html>
