<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    <link rel="preload" href="{{ 'michroma-latin-400.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    {% render 'meta-tags' %}

    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <script type="importmap">
      {
        "imports": {
          "vendor-three": "{{ 'vendor-three.js' | asset_url }}",
          "vendor-gsap": "{{ 'vendor-gsap.js' | asset_url }}",
          "keychain3d": "{{ 'keychain3d.js' | asset_url }}"
        }
      }
    </script>
    <script>
      window.GT = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          search: {{ routes.search_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          cartError: {{ 'cart.error_generic' | t | json }},
          searchError: {{ 'search.error' | t | json }},
          searchLoading: {{ 'search.loading' | t | json }},
          added: {{ 'cart.added' | t | json }}
        },
        meshopt: true
      };
    </script>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'global.js' | asset_url }}" type="module"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#main">{{ 'general.skip_to_content' | t }}</a>
    {% sections 'header-group' %}

    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-dialog' %}
    {% section 'cart-drawer' %}
    <div class="visually-hidden" aria-live="polite" aria-atomic="true" id="live-region"></div>
  </body>
</html>
