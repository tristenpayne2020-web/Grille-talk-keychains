{%- comment -%} What you get, as a spec sheet on white. Every line is a fact from the brief; nothing invented. {%- endcomment -%}
<section class="section section--paper specs" id="benefits" aria-labelledby="benefits-title">
  <div class="page-width specs__grid">
    <div data-reveal>
      <p class="t-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="h-2" id="benefits-title" style="margin-top: var(--s-3)">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="lede rte" style="margin-top: var(--s-5)">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="specs__dims">
        {%- if section.settings.dim_1 != blank -%}<p class="specs__dim"><strong>{{ section.settings.dim_1 | escape }}</strong><span>{{ section.settings.dim_1_label | escape }}</span></p>{%- endif -%}
        {%- if section.settings.dim_2 != blank -%}<p class="specs__dim"><strong>{{ section.settings.dim_2 | escape }}</strong><span>{{ section.settings.dim_2_label | escape }}</span></p>{%- endif -%}
      </div>
    </div>
    <ol class="specs__list" role="list">
      {%- for block in section.blocks -%}
        <li class="specs__item" {{ block.shopify_attributes }} data-reveal>
          <span class="specs__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What you get" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built from the front, the way you spot your car." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Each design starts as a straight-on trace of the real car. We keep the details owners notice and drop the rest.</p>" },
    { "type": "text", "id": "dim_1", "label": "Figure 1", "default": "80.5 mm" },
    { "type": "text", "id": "dim_1_label", "label": "Figure 1 label", "default": "wide" },
    { "type": "text", "id": "dim_2", "label": "Figure 2", "default": "3 mm" },
    { "type": "text", "id": "dim_2_label", "label": "Figure 2 label", "default": "thick" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Benefits" }]
}
{% endschema %}
