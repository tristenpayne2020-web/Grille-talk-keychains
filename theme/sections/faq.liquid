{%- comment -%}
  FAQ. A question only shows once its answer is filled in, so empty blocks can wait in the editor for the owner.
{%- endcomment -%}
<section class="section faq{% if section.settings.heading == blank %} section--tight{% endif %}" id="faq"{% if section.settings.heading != blank %} aria-labelledby="faq-title-{{ section.id }}"{% else %} aria-label="{{ 'general.faq' | t }}"{% endif %}>
  <div class="page-width{% if section.settings.heading != blank %} faq__grid{% endif %}">
    {%- if section.settings.heading != blank -%}
    <div data-reveal>
      <p class="t-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="h-2" id="faq-title-{{ section.id }}" style="margin-top: var(--s-3)">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.contact_line != blank and settings.contact_email != blank -%}
        <p class="t-mute" style="margin-top: var(--s-4)">{{ section.settings.contact_line | escape }} <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></p>
      {%- endif -%}
    </div>
    {%- endif -%}
    <div class="faq__list{% if section.settings.heading == blank %} page-narrow{% endif %}">
      {%- for block in section.blocks -%}
        {%- if block.settings.answer != blank -%}
          <details class="faq__item" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}{% render 'icon', name: 'plus' %}</summary>
            <div class="faq__answer rte">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- capture faq_json -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.answer != blank -%}
      {"@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ block.settings.answer | strip_html | json }}}},
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if faq_json != blank -%}
  <script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{{ faq_json | remove_last: ',' }}]}</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good questions" },
    { "type": "text", "id": "contact_line", "label": "Contact line", "default": "Something else? Email" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "info": "The question stays hidden until this is filled in." }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
