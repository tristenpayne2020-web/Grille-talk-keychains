<section class="not-found page-width" aria-labelledby="pw-title" style="justify-items: center; text-align: center">
  <img src="{{ 'logo-metal-1600.webp' | asset_url }}" alt="{{ shop.name | escape }}" width="1600" height="262" style="width: min(560px, 90%)">
  <h1 class="h-3" id="pw-title">{{ section.settings.heading | escape }}</h1>
  {%- if shop.password_message != blank -%}<p class="lede">{{ shop.password_message | escape }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'search-form' -%}
    {%- if form.errors -%}<p class="form-msg form-msg--error" role="alert">{{ form.errors.messages['form'] }}</p>{%- endif -%}
    <label class="visually-hidden" for="pw">{{ 'password.label' | t }}</label>
    <input class="input" id="pw" type="password" name="password" autocomplete="current-password" required>
    <button class="btn" type="submit">{{ 'password.enter' | t }}</button>
  {%- endform -%}
</section>

{% schema %}
{ "name": "Password", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "We turn the car you love into the keychain you carry. Opening soon." }] }
{% endschema %}
