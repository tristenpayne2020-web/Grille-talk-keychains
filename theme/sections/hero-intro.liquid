{%- comment -%}
  Home hero: one complete shot. The 3D keychain on its physics chain dominates the stage, copy sits at the left,
  a mono stat row underneath, and other designs drift at depth behind. The static render (aligned to the same frame)
  is the end state without JS or WebGL, and what phones show until the visitor first touches or scrolls.
{%- endcomment -%}
{%- liquid
  assign hp = section.settings.product
  assign model_url = ''
  if hp != blank
    for media in hp.media
      if media.media_type == 'model'
        assign glb = media.sources | where: 'format', 'glb' | first
        assign model_url = glb.url
        break
      endif
    endfor
  endif
  assign shop_href = section.settings.shop_link | default: '#range'
-%}
<section class="hero" id="hero" data-hero data-chapter="{{ 'chapters.hero' | t }}" data-model="{{ model_url }}" aria-labelledby="hero-title">
  <div class="hero__drift" aria-hidden="true" data-drift>
    {%- for p in collections.all.products offset: 1 limit: 6 -%}
      {%- if p.featured_image -%}
        <span class="hero__float" style="--i: {{ forloop.index0 }}">{{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '', width: 400, height: 400 }}</span>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="hero__grid page-width">
    <div class="hero__copy">
      <p class="t-eyebrow hero__eyebrow"><span class="hero__dot" aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}</p>
      <h1 class="hero__title" id="hero-title">{{ section.settings.heading | escape }}</h1>
      <p class="hero__sub">{{ section.settings.subheading | escape }}</p>
      <div class="hero__actions">
        <a class="btn" href="{{ shop_href }}" data-magnetic>{{ section.settings.shop_label | escape }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>
        <a class="btn btn--ghost" href="{{ routes.search_url }}" data-open="search-dialog" aria-haspopup="dialog">{% render 'icon', name: 'search', class: 'icon--sm' %}{{ section.settings.search_label | escape }}</a>
      </div>
    </div>

    <div class="hero__art">
      <div class="hero__box" data-hero-art>
        <div class="hero__static stage" data-hero-static>
          <div class="stage__fallback">
            {%- if section.settings.image != blank -%}
              {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 1000, 1600', sizes: '(min-width: 990px) 62vw, 100vw', alt: section.settings.image_alt }}
            {%- else -%}
              <img src="{{ 'hero-g80.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1600" height="1135" fetchpriority="high">
            {%- endif -%}
          </div>
        </div>
        <div class="hero__3d stage" data-hero-3d aria-hidden="true"></div>
      </div>
    </div>
  </div>

  <dl class="hero__stats page-width">
    {%- for block in section.blocks -%}
      <div class="hero__stat" {{ block.shopify_attributes }}>
        <dt class="t-mono">{{ block.settings.label | escape }}</dt>
        <dd>{{ block.settings.value | escape }}</dd>
      </div>
    {%- endfor -%}
  </dl>
</section>

<script src="{{ 'hero.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Keychain shown in 3D", "info": "Pick the BMW M3 (G80). Its 3D model is used in the hero." },
    { "type": "image_picker", "id": "image", "label": "Static image (no JS, before 3D loads)", "info": "Optional. Defaults to the built-in G80 render." },
    { "type": "text", "id": "image_alt", "label": "Static image alt text", "default": "Grille Talk keychain inspired by the BMW M3 (G80), white body, hanging from its chain" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "3D-printed car-front keychains" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We turn the car you love into the keychain you carry." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Detailed fronts of real cars, light signatures and all. Find your own car or a dream car, pick a body color, done." },
    { "type": "text", "id": "shop_label", "label": "Shop button", "default": "Shop the range" },
    { "type": "url", "id": "shop_link", "label": "Shop button link", "info": "Defaults to the range viewer on this page." },
    { "type": "text", "id": "search_label", "label": "Search button", "default": "Find my car" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
