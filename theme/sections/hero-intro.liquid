{%- comment -%}
  Home hero. The end state (keychain render, copy, Shop and Search) is plain HTML, so it is what visitors see without
  JS or with reduced motion. With JS, once per session: black, the G80's DRL signatures light up (drawn from the
  real keychain geometry), the logo reveals, then everything hands over to the 3D keychain on its chain.
{%- endcomment -%}
{%- liquid
  assign hp = section.settings.product
  assign model_url = ''
  if hp != blank
    for media in hp.media
      if media.media_type == 'model'
        assign glb = media.sources | where: 'format', 'glb' | first
        assign model_url = glb.url
        break
      endif
    endfor
  endif
  assign shop_href = section.settings.shop_link | default: '#range'
-%}
<section class="hero is-intro-ready" id="hero" data-hero data-model="{{ model_url }}" aria-labelledby="hero-title">
  <div class="hero__art">
   <div class="hero__box" data-hero-art>
    <div class="hero__body-dots" style="--outline-mask: url('{{ 'hero-outline.svg' | asset_url }}')" aria-hidden="true"></div>
    <div class="hero__drl" aria-hidden="true">{% render 'hero-drl' %}</div>
    <div class="hero__logo" aria-hidden="true">
      <img src="{{ 'logo-metal-1600.webp' | asset_url }}" alt="" width="1600" height="262" fetchpriority="high">
    </div>
    <div class="hero__static stage" data-hero-static>
      <div class="stage__fallback">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 1000, 1400, 2000', sizes: '(min-width: 1100px) 1080px, 100vw', alt: section.settings.image_alt }}
        {%- else -%}
          <img src="{{ 'hero-g80.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1600" height="1135" fetchpriority="high">
        {%- endif -%}
      </div>
    </div>
    <div class="hero__3d stage" data-hero-3d aria-hidden="true"></div>
   </div>
  </div>

  <div class="hero__copy page-width">
    <p class="t-eyebrow" data-hero-copy>{{ section.settings.eyebrow | escape }}</p>
    <h1 class="hero__title" id="hero-title" data-hero-copy>{{ section.settings.heading | escape }}</h1>
    <p class="hero__sub" data-hero-copy>{{ section.settings.subheading | escape }}</p>
    <div class="hero__actions" data-hero-copy>
      <a class="btn" href="{{ shop_href }}">{{ section.settings.shop_label | escape }}</a>
      <a class="btn btn--ghost" href="{{ routes.search_url }}" data-open="search-dialog" aria-haspopup="dialog">{% render 'icon', name: 'search', class: 'icon--sm' %}{{ section.settings.search_label | escape }}</a>
    </div>
  </div>
  <button type="button" class="btn btn--ghost hero__skip" data-hero-skip hidden>{% render 'icon', name: 'skip', class: 'icon--sm' %}{{ 'general.skip_intro' | t }}</button>
</section>

<script src="{{ 'hero.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Hero intro",
  "settings": [
    { "type": "product", "id": "product", "label": "Keychain shown in 3D", "info": "Pick the BMW M3 (G80). Its 3D model is used after the intro." },
    { "type": "image_picker", "id": "image", "label": "Static image (no JS, reduced motion)", "info": "Optional. Defaults to the built-in G80 render." },
    { "type": "text", "id": "image_alt", "label": "Static image alt text", "default": "Grille Talk keychain inspired by the BMW M3 (G80), white body, hanging from its chain" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "3D-printed car-front keychains" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We turn the car you love into the keychain you carry." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Detailed fronts of real cars, light signatures and all. Find your own car or a dream car, pick a body color, done." },
    { "type": "text", "id": "shop_label", "label": "Shop button", "default": "Shop" },
    { "type": "url", "id": "shop_link", "label": "Shop button link", "info": "Defaults to the range viewer on this page." },
    { "type": "text", "id": "search_label", "label": "Search button", "default": "Search" }
  ],
  "presets": [{ "name": "Hero intro" }]
}
{% endschema %}
