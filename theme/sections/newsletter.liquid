<section data-chapter="{{ 'chapters.newsletter' | t }}" class="section section--tight newsletter" id="newsletter" aria-labelledby="newsletter-title-{{ section.id }}">
  <div class="page-width newsletter__inner">
    <div data-reveal>
      <p class="t-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="h-3" id="newsletter-title-{{ section.id }}" style="margin-top: var(--s-3)">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="t-mute" style="margin-top: var(--s-3)">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <div>
      {%- form 'customer', id: 'newsletter-form', class: 'newsletter__wrap' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-msg" role="status" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="form-msg form-msg--error" role="alert" id="newsletter-error" style="margin-bottom: var(--s-3)">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</div>
          {%- endif -%}
          <div class="newsletter__form">
            <label class="visually-hidden" for="newsletter-email">{{ 'newsletter.label' | t }}</label>
            <input class="input" id="newsletter-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="newsletter-error"{% endif %}>
            <button class="btn" type="submit">{{ section.settings.button | escape }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New cars" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hear when your car drops." },
    { "type": "text", "id": "text", "label": "Text", "default": "40+ more designs are on the way. One email when new cars land." },
    { "type": "text", "id": "button", "label": "Button", "default": "Sign up" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
