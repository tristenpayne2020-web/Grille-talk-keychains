{%- comment -%}
  Product page: 3D model (model_viewer_tag) and renders, body color swatches grouped by tier with prices from the
  variants, add to cart and Shopify's dynamic checkout button. Picking a color updates the variant, price, URL and the
  3D model's body material. Production time and shipping show only once filled in under Theme settings.
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign model = product.media | where: 'media_type', 'model' | first
  assign short = product.metafields.custom.short_model.value | default: product.metafields.custom.short_model
-%}
<section class="section section--tight" aria-labelledby="product-title">
  <div class="page-width product" data-product data-handle="{{ product.handle }}">
    <div class="product__media">
      <div class="product__viewer{% unless model %} is-ready{% endunless %}" data-viewer>
        {%- if model -%}
          {% render 'skeleton' %}
          {{ model | model_viewer_tag: image_size: '1200x', reveal: 'auto', interaction-prompt: 'none', camera-orbit: '0deg 90deg auto', min-camera-orbit: '-70deg 50deg auto', max-camera-orbit: '70deg 120deg auto', shadow-intensity: '0.6', exposure: '1.05', environment-image: 'neutral', disable-zoom: true, data-model: '' }}
          <p class="product__viewer-hint">{% render 'icon', name: 'rotate', class: 'icon--sm' %} {{ 'products.view_3d' | t }}</p>
        {%- elsif product.featured_image -%}
          {{ product.featured_image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 58vw, 100vw', alt: product.featured_image.alt }}
        {%- endif -%}
      </div>
      <ul class="product__gallery" role="list" aria-label="{{ 'products.media_label' | t: title: product.title | escape }}">
        {%- if current.featured_image -%}
          <li>{{ current.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 28vw, 50vw', alt: current.featured_image.alt, data-variant-image: '' }}</li>
        {%- endif -%}
        {%- for image in product.images -%}
          {%- liquid
            assign is_variant_image = false
            for v in product.variants
              if v.featured_image.src == image.src
                assign is_variant_image = true
              endif
            endfor
          -%}
          {%- unless is_variant_image -%}
            <li>{{ image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 28vw, 50vw', alt: image.alt }}</li>
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="product__info">
      <div>
        <p class="t-eyebrow">{{ product.metafields.custom.make.value | default: product.vendor | escape }}</p>
        <h1 class="product__title" id="product-title" style="margin-top: var(--s-3)">{{ product.title | escape }}</h1>
        {%- if short != blank -%}<p class="t-mute" style="margin-top: var(--s-2)">{{ 'products.for_owners' | t: model: short }}</p>{%- endif -%}
      </div>
      <p class="product__price" data-price aria-live="polite">{{ current.price | money }}</p>

      {%- form 'product', product, id: 'product-form', class: 'buy', data-product-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
        {%- unless product.has_only_default_variant -%}
          {% render 'swatches', product: product, current: current %}
        {%- endunless -%}
        <div class="field">
          <label for="qty">{{ 'products.quantity' | t }}</label>
          <div class="qty">
            <button type="button" data-step="-1" aria-label="{{ 'cart.decrease' | t: title: product.title | escape }}">{% render 'icon', name: 'minus', class: 'icon--sm' %}</button>
            <input id="qty" type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric">
            <button type="button" data-step="1" aria-label="{{ 'cart.increase' | t: title: product.title | escape }}">{% render 'icon', name: 'plus', class: 'icon--sm' %}</button>
          </div>
        </div>
        <p class="form-msg form-msg--error" data-form-error role="alert" hidden></p>
        <button class="btn btn--block" type="submit" name="add" {% unless current.available %}disabled{% endunless %}>
          <span class="btn__spinner" aria-hidden="true"></span>
          <span class="btn__label">{% if current.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
        </button>
        {%- if section.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
      {%- endform -%}

      <div>
        <h2 class="t-eyebrow" style="margin-bottom: var(--s-3)">{{ 'products.facts_title' | t }}</h2>
        <ul class="facts" role="list">
          <li><span>{{ 'products.fact_size' | t }}</span><span>{{ 'products.fact_size_value' | t }}</span></li>
          <li><span>{{ 'products.fact_print' | t }}</span><span>{{ 'products.fact_print_value' | t }}</span></li>
          <li><span>{{ 'products.fact_included' | t }}</span><span>{{ 'products.fact_included_value' | t }}</span></li>
          <li><span>{{ 'products.fact_design' | t }}</span><span>{{ 'products.fact_design_value' | t }}</span></li>
          {%- if settings.production_time != blank -%}<li><span>{{ 'products.fact_production' | t }}</span><span>{{ settings.production_time | escape }}</span></li>{%- endif -%}
          {%- if settings.shipping_note != blank -%}<li><span>{{ 'products.fact_shipping' | t }}</span><span>{{ settings.shipping_note | escape }}</span></li>{%- endif -%}
        </ul>
      </div>
      {%- if product.description != blank -%}<div class="rte t-mute">{{ product.description }}</div>{%- endif -%}
      <p class="notice">{{ settings.legal_notice | escape }}</p>
    </div>
  </div>

  <script type="application/json" data-product-json>
    {
      "variants": [
        {%- for v in product.variants -%}
          { "id": {{ v.id }}, "option1": {{ v.option1 | json }}, "price": {{ v.price | money | json }}, "available": {{ v.available | json }},
            "image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %},
            "imageAlt": {{ v.featured_image.alt | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "strings": { "addToCart": {{ 'products.add_to_cart' | t | json }}, "soldOut": {{ 'products.sold_out' | t | json }} }
    }
  </script>
</section>

<script src="{{ 'product.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Shop Pay / dynamic checkout button", "default": true }
  ]
}
{% endschema %}
