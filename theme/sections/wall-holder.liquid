{%- comment -%}
  Wall-mounted key holder feature: the holder hung on a lit wall panel, a portrait film of it (snippet 'film'), its price from the variants, and the mounting
  advice (double-sided tape recommended; countersunk holes for a screw or nail). With a collection set, a row of
  thumbnails (each holder in a different body colour) swaps the one on the wall.
{%- endcomment -%}
{%- liquid
  assign wp = section.settings.product
  assign col = section.settings.collection
  if wp == blank and col != blank
    assign wp = col.products | first
  endif
  assign hero_img = wp.featured_image
  for image in wp.images
    assign alt_lc = image.alt | downcase
    if alt_lc contains 'white body, front view'
      assign hero_img = image
      break
    endif
  endfor
-%}
{%- if wp != blank -%}
<section class="section wallhold" id="wall-key-holder" data-chapter="{{ 'chapters.wall' | t }}" aria-labelledby="wall-title">
  <div class="page-width wallhold__grid">
    <div class="wallhold__copy">
      <p class="t-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="h-2" id="wall-title">{{ section.settings.heading | escape }}</h2>
      <p class="lede">{{ section.settings.text | escape }}</p>
      <ul class="wallhold__facts" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><span class="t-mono">{{ block.settings.label | escape }}</span><span>{{ block.settings.value | escape }}</span></li>
        {%- endfor -%}
      </ul>
      <div class="wallhold__buy">
        {%- assign from_price = wp.price_min | money -%}
        <p class="wallhold__price" data-wall-price>{{ 'products.from_price_html' | t: price: from_price }}</p>
        <a class="btn" href="{{ wp.url }}" data-wall-link data-magnetic>{{ section.settings.button | escape }}<span class="visually-hidden" data-wall-name>: {{ wp.title | escape }}</span> {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>
        {%- if col != blank -%}<a class="link-arrow" href="{{ col.url }}">{{ section.settings.all_label | escape }}</a>{%- endif -%}
      </div>
    </div>
    <div class="wallhold__wall" aria-hidden="true">
      <span class="wallhold__lamp"></span>
      <div class="wallhold__piece">
        {%- if hero_img -%}
          {{ hero_img | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 1000, 1600', sizes: '(min-width: 990px) 56vw, 100vw', alt: '', data-wall-img: '' }}
        {%- endif -%}
      </div>
      <span class="wallhold__shadow"></span>
    </div>
    <div class="wallhold__film">
      {%- render 'film', video: section.settings.film, fallback: 'film-wall.mp4', poster: 'film-wall-poster.webp', label: section.settings.film_label -%}
    </div>
    {%- if col != blank and col.products_count > 1 -%}
      {%- liquid
        assign swatch_lines = settings.color_swatches | newline_to_br | split: '<br />'
        assign ncol = swatch_lines.size
      -%}
      <ul class="wallhold__pick" role="list" aria-label="{{ section.settings.pick_label | escape }}">
        {%- for p in col.products -%}
          {%- liquid
            assign ci = forloop.index0 | modulo: ncol
            assign sp = swatch_lines[ci] | split: ':'
            assign want = sp[0] | strip | downcase | append: ' body, front view'
            assign pimg = p.featured_image
            for image in p.images
              assign alt_lc = image.alt | downcase
              if alt_lc contains want
                unless alt_lc contains 'on white'
                  assign pimg = image
                  break
                endunless
              endif
            endfor
            if p.id == wp.id
              assign pimg = hero_img
            endif
            assign p_price = p.price_min | money
            assign p_short = p.metafields.custom.short_model.value | default: p.metafields.custom.short_model | default: p.title
          -%}
          <li>
            <button type="button" class="wallhold__thumb" data-wall-pick
              data-url="{{ p.url }}" data-title="{{ p.title | escape }}"
              data-price="{{ 'products.from_price_html' | t: price: p_price | strip_html | escape }}"
              data-src="{{ pimg | image_url: width: 1000 }}"
              data-srcset="{{ pimg | image_url: width: 600 }} 600w, {{ pimg | image_url: width: 1000 }} 1000w, {{ pimg | image_url: width: 1600 }} 1600w"
              aria-pressed="{% if p.id == wp.id %}true{% else %}false{% endif %}">
              {{ pimg | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', sizes: '140px', alt: '' }}
              <span>{{ p_short | escape }}</span>
            </button>
          </li>
        {%- endfor -%}
      </ul>
      <script src="{{ 'wall.js' | asset_url }}" type="module"></script>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Wall key holder",
  "settings": [
    { "type": "product", "id": "product", "label": "Wall key holder" },
    { "type": "collection", "id": "collection", "label": "Wall key holder collection", "info": "An automated collection where Product type is Wall key holder." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wall-mounted key holder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your car, by the front door." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The same front, scaled up for the wall, with four hooks for your keys. Same body colors." },
    { "type": "text", "id": "button", "label": "Button", "default": "View the key holder" },
    { "type": "text", "id": "all_label", "label": "Collection link", "default": "All wall key holders" },
    { "type": "text", "id": "pick_label", "label": "Picker label (screen readers)", "default": "Choose a wall key holder" },
    { "type": "video", "id": "film", "label": "Film (9:16)", "info": "Upload grilletalk_wall_9x16.mp4 in Content > Files and pick it here. Without it the theme's own copy plays." },
    { "type": "text", "id": "film_label", "label": "Film description (screen readers)", "default": "Film: a set of keys swings onto a hook of a white Supra wall key holder, the holder cycles through the body colors, then the full range on the wall." }
  ],
  "blocks": [
    { "type": "fact", "name": "Fact", "settings": [ { "type": "text", "id": "label", "label": "Label" }, { "type": "text", "id": "value", "label": "Value" } ] }
  ],
  "presets": [{ "name": "Wall key holder" }]
}
{% endschema %}
