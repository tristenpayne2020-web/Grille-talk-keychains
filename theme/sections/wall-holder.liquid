{%- comment -%}
  Wall-mounted key holder feature: the holder hung on a lit wall panel, its price from the variants, and the mounting
  advice (double-sided tape recommended; countersunk holes for a screw or nail).
{%- endcomment -%}
{%- liquid
  assign wp = section.settings.product
  assign col = section.settings.collection
  if wp == blank and col != blank
    assign wp = col.products | first
  endif
  assign hero_img = wp.featured_image
  for image in wp.images
    assign alt_lc = image.alt | downcase
    if alt_lc contains 'white body, front view'
      assign hero_img = image
      break
    endif
  endfor
-%}
{%- if wp != blank -%}
<section class="section wallhold" id="wall-key-holder" data-chapter="{{ 'chapters.wall' | t }}" aria-labelledby="wall-title">
  <div class="page-width wallhold__grid">
    <div class="wallhold__copy">
      <p class="t-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="h-2" id="wall-title">{{ section.settings.heading | escape }}</h2>
      <p class="lede">{{ section.settings.text | escape }}</p>
      <ul class="wallhold__facts" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><span class="t-mono">{{ block.settings.label | escape }}</span><span>{{ block.settings.value | escape }}</span></li>
        {%- endfor -%}
      </ul>
      <div class="wallhold__buy">
        {%- assign from_price = wp.price_min | money -%}
        <p class="wallhold__price">{{ 'products.from_price_html' | t: price: from_price }}</p>
        <a class="btn" href="{{ wp.url }}" data-magnetic>{{ section.settings.button | escape }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>
        {%- if col != blank -%}<a class="link-arrow" href="{{ col.url }}">{{ section.settings.all_label | escape }}</a>{%- endif -%}
      </div>
    </div>
    <div class="wallhold__wall" aria-hidden="true">
      <span class="wallhold__lamp"></span>
      <div class="wallhold__piece">
        {%- if hero_img -%}
          {{ hero_img | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 1000, 1600', sizes: '(min-width: 990px) 56vw, 100vw', alt: '' }}
        {%- endif -%}
      </div>
      <span class="wallhold__shadow"></span>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Wall key holder",
  "settings": [
    { "type": "product", "id": "product", "label": "Wall key holder" },
    { "type": "collection", "id": "collection", "label": "Wall key holder collection", "info": "An automated collection where Product type is Wall key holder." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wall-mounted key holder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your car, by the front door." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The same front, scaled up for the wall, with four hooks for your keys. Same body colors, same headlight options." },
    { "type": "text", "id": "button", "label": "Button", "default": "View the key holder" },
    { "type": "text", "id": "all_label", "label": "Collection link", "default": "All wall key holders" }
  ],
  "blocks": [
    { "type": "fact", "name": "Fact", "settings": [ { "type": "text", "id": "label", "label": "Label" }, { "type": "text", "id": "value", "label": "Value" } ] }
  ],
  "presets": [{ "name": "Wall key holder" }]
}
{% endschema %}
