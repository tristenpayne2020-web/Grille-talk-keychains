<section class="section" aria-labelledby="contact-title">
  <div class="page-width split">
    <div>
      <p class="t-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="h-2" id="contact-title" style="margin-top: var(--s-3)">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}<p class="lede" style="margin-top: var(--s-4)">{{ section.settings.text | escape }}</p>{%- endif -%}
      <div class="contact-links" style="margin-top: var(--s-6); font-size: var(--t-lg)">
        {%- if settings.contact_email != blank -%}
          <a href="mailto:{{ settings.contact_email }}">{% render 'icon', name: 'mail' %}{{ settings.contact_email }}</a>
        {%- endif -%}
        {%- if settings.contact_phone != blank -%}
          <a href="tel:{{ settings.contact_phone_tel }}">{% render 'icon', name: 'phone' %}{{ settings.contact_phone }}</a>
        {%- endif -%}
      </div>
    </div>
    <div>
      {%- form 'contact', id: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-msg" role="status" tabindex="-1" autofocus>{{ 'contact.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="form-msg form-msg--error" role="alert" style="margin-bottom: var(--s-4)">
              <p>{{ 'contact.error_heading' | t }}</p>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
          <div class="form-grid form-grid--2">
            <div class="field"><label for="c-name">{{ 'contact.name' | t }}</label><input class="input" id="c-name" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
            <div class="field"><label for="c-email">{{ 'contact.email' | t }}</label><input class="input" id="c-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}></div>
            <div class="field span-2"><label for="c-phone">{{ 'contact.phone' | t }}</label><input class="input" id="c-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></div>
            <div class="field span-2"><label for="c-body">{{ 'contact.message' | t }}</label><textarea class="input" id="c-body" name="contact[body]" required>{{ form.body }}</textarea></div>
            <div class="span-2"><button class="btn" type="submit">{{ 'contact.send' | t }}</button></div>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk cars with us." },
    { "type": "text", "id": "text", "label": "Text", "default": "Questions about an order, a design or a car club run? Email, call or use the form." }
  ]
}
{% endschema %}
