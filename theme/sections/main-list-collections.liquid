<section class="section section--tight" aria-labelledby="collections-title">
  <div class="page-width">
    <h1 class="h-2" id="collections-title" style="margin-bottom: var(--s-6)">{{ section.settings.heading | escape }}</h1>
    <ul class="grid" role="list">
      {%- for collection in collections -%}
        <li class="card">
          <div class="card__media">{%- if collection.featured_image -%}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 750px) 30vw, 46vw', alt: '' }}{%- endif -%}</div>
          <h2 class="card__title"><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h2>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{ "name": "Collections list", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }] }
{% endschema %}
